# =============================================================================
# Orion School Management System - Hostinger Environment Configuration
# =============================================================================
# Copy this file to .env and configure the variables for your deployment.

# --- Application Host & Port ---
HOST=0.0.0.0
PORT=8000
APP_URL=https://orionbasicskool.com


# --- Security & JWT Secret ---
# IMPORTANT: Generate a strong 32+ character random string for production
JWT_SECRET=orion-super-secret-key-change-this-in-production-12345!@#$

# --- File Storage & Persistence ---
# Directory where SQLite databases (.db) and config.json are stored
# Leave blank for default (project root) or specify absolute path (e.g. /var/www/orion/data)
# DATA_DIR=/var/www/orion/data
# UPLOADS_DIR=/var/www/orion/web/uploads

# --- Database Configuration (Optional - Defaults to SQLite) ---
# If using SQLite (default):
# Leave DATABASE_URL and MASTER_DATABASE_URL unset.
#
# If using PostgreSQL (e.g., Hostinger Cloud or Managed PostgreSQL):
# DATABASE_URL=postgresql://orion_user:strong_password@localhost:5432/orion_school
# MASTER_DATABASE_URL=postgresql://orion_user:strong_password@localhost:5432/orion_master

# --- Global SMS Gateway (Arkesel / Twilio) ---
SMS_PROVIDER=Arkesel
SMS_SENDER_ID=ORION
SMS_API_KEY=your_arkesel_api_key_here

# --- Payment Gateway (Paystack / Mobile Money) ---
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# --- Logging & Debugging ---
DEBUG=False
