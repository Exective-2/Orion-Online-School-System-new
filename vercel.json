{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.py"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "server.py"
    },
    {
      "src": "/js/(.*)",
      "dest": "web/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "web/css/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "web/assets/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "web/icons/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "web/manifest.json",
      "headers": { "Content-Type": "application/manifest+json" }
    },
    {
      "src": "/sw.js",
      "dest": "web/sw.js",
      "headers": {
        "Content-Type": "application/javascript",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "src": "/offline.html",
      "dest": "web/offline.html"
    },
    {
      "src": "/(.*)",
      "dest": "web/index.html"
    }
  ]
}
